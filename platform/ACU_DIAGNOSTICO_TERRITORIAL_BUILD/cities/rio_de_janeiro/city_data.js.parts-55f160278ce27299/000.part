window.ACU_CITY_DATA_rio_de_janeiro={"config":{"city_id":"rio_de_janeiro","city_name":"Rio de Janeiro","state":"RJ","ibge_code":"3304557","default_program_geography_id":"PAVUNA_ACU_OPERATIONAL_2022","default_comparison_level":"RJ_ADMINISTRATIVE_REGION","comparison_levels":["RJ_ADMINISTRATIVE_REGION"],"available_modules":["panorama","population","education","living","income","violence","compare","assistant","sources"],"availability_status":"AVAILABLE_WITH_LIMITATIONS","default_view":[-22.82,-43.36,12],"program_territory_summary":"Pavuna — Território Agenda Cidade UNICEF · Região Administrativa da Pavuna","program_territories":[{"territory_id":"PAVUNA_ACU_OPERATIONAL_2022","territory_name":"Pavuna","territory_role":"PROGRAM_TERRITORY","sector_count":411,"source_id":"SRC_UNICEF_ACU_GUIDE_2025_2028","source_ids":["SRC_IBGE_CENSUS_SECTORS_2022_RJ","SRC_PCRJ_ACU_RA_PAVUNA_2022","SRC_PCRJ_IPP_ADMINISTRATIVE_REGIONS_2026","SRC_UNICEF_ACU_GUIDE_2025_2028","SRC_UNICEF_ACU_PROGRAM_PAGE_2026"],"lineage_id":"LIN_RJ_PAVUNA_ACU_OPERATIONAL_2022_CONTRACT","active":true}],"limitations":["1.167 de 3.897 escolas possuem localização espacial validada (29.9461%). Ausência de marcador não significa ausência de escola.","Os equipamentos representam catálogos oficiais adquiridos, com completude variável por família; não constituem censo universal nem medida de suficiência ou acesso.","WASH escolar descreve infraestrutura declarada no Censo Escolar 2025; não é resultado programático UNICEF.","PAVUNA_ACU_OPERATIONAL_2022 corresponde à Região Administrativa da Pavuna (RA 25), não ao bairro Pavuna (código 114).","Indicadores censitários submunicipais são agregados exatamente de setores 2022; componente suprimido ou ausente resulta em N/D governado.","Violência e proteção permanecem PENDING_SOURCE quando não há aquisição oficial governada; nenhum valor municipal é redistribuído.","PCT é publicado somente como agregado municipal; registros INTERNAL_ONLY foram excluídos e a reconciliação territorial permanece pendente.","Taxas de trajetória usam razão de somas com numeradores aproximados derivados de taxas escolares arredondadas."],"public_map_geography_level":"RJ_ADMINISTRATIVE_REGION","public_map_geography_label":"Regiões Administrativas"},"geographies":[{"id":"RJ_MUNICIPALITY","name":"Rio de Janeiro","display_name":"Rio de Janeiro — município","level":"MUNICIPALITY","comparable":false},{"id":"RJ_RA::1","name":"Portuária","display_name":"RA Portuária","level":"RJ_ADMINISTRATIVE_REGION","comparable":true,"official_code":"1"},{"id":"RJ_RA::2","name":"Centro","display_name":"RA Centro","level":"RJ_ADMINISTRATIVE_REGION","comparable":true,"official_code":"2"},{"id":"RJ_RA::3","name":"Rio Comprido","display_name":"RA Rio Comprido","level":"RJ_ADMINISTRATIVE_REGION","comparable":true,"official_code":"3"},{"id":"RJ_RA::4","name":"Botafogo","display_name":"RA Botafogo","level":"RJ_ADMINISTRATIVE_REGION","comparable":true,"official_code":"4"},{"id":"RJ_RA::5","name":"Copacabana","display_name":"RA Copacabana","level":"RJ_ADMINISTRATIVE_REGION","comparable":true,"official_code":"5"},{"id":"RJ_RA::6","name":"Lagoa","display_name":"RA Lagoa","level":"RJ_ADMINISTRATIVE_REGION","comparable":true,"official_code":"6"},{"id":"RJ_RA::7","name":"São Cristóvão","display_name":"RA São Cristóvão","level":"RJ_ADMINISTRATIVE_REGION","comparable":true,"official_code":"7"},{"id":"RJ_RA::8","name":"Tijuca","display_name":"RA Tijuca","level":"RJ_ADMINISTRATIVE_REGION","comparable":true,"official_code":"8"},{"id":"RJ_RA::9","name":"Vila Isabel","display_name":"RA Vila Isabel","level":"RJ_ADMINISTRATIVE_REGION","comparable":true,"official_code":"9"},{"id":"RJ_RA::10","name":"Ramos","display_name":"RA Ramos","level":"RJ_ADMINISTRATIVE_REGION","comparable":true,"official_code":"10"},{"id":"RJ_RA::11","name":"Penha","display_name":"RA Penha","level":"RJ_ADMINISTRATIVE_REGION","comparable":true,"official_code":"11"},{"id":"RJ_RA::12","name":"Inhaúma","display_name":"RA Inhaúma","level":"R